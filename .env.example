# --- OpenRouter (AI: chat completions + embeddings) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat + embedding models (OpenRouter model ids)
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# --- Auth ---
# Secret used to sign session tokens. Use a long random string in real deploys.
SESSION_SECRET=dev-insecure-secret-change-me

# --- App ---
# Public base URL, used to build the embed snippet + widget iframe src.
NEXT_PUBLIC_APP_URL=http://localhost:3000
